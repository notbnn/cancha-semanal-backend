// Esquema PostgreSQL — corresponde a §03 del documento de arquitectura.
// Deliberadamente mínimo: sin costo_reserva ni meta_recaudacion, esos datos
// financieros del anfitrión viven solo en SQLite (Flutter), no acá.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Evento {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  fecha         DateTime
  nombreCancha  String?  @map("nombre_cancha")
  // Nombre que el organizador le pone al partido (ej. "Bajo Llojeta").
  // Si no lo mandan, la pagina publica usa "Partido semanal" como antes.
  titulo        String?  @map("titulo")
  // Nullable a propósito: se completa recién en POST /api/eventos/:id/qr,
  // después de crear el evento (§04) — no existe todavía al crearlo.
  qrUrl         String?  @map("qr_url")
  // Hora de fin del partido, ej. "22:00". Solo texto: la hora de inicio ya
  // vive en `fecha` (incluye fecha+hora), esto es únicamente para mostrar
  // "de 20:00 a 22:00" en la página pública — no se usa para lógica.
  horaFin       String?  @map("hora_fin")
  // Link de Google Maps tal cual lo comparte la app de Maps (boton
  // "Compartir"). No guardamos lat/lng ni nada estructurado — es un MVP,
  // solo necesitamos poder abrirlo. Se valida que sea texto no vacio, no
  // que sea una URL real (si el organizador pega cualquier cosa, es su
  // problema, no rompe nada del backend).
  ubicacionUrl  String?  @map("ubicacion_url")
  estado        String   @default("abierto")
  // Token que la app guarda en secure storage para autenticar los
  // endpoints de admin de este evento (§04). MVP: token simple por evento,
  // no hay login de usuario en el backend.
  adminToken    String   @map("admin_token")
  creadoEn      DateTime @default(now()) @map("creado_en")

  confirmaciones Confirmacion[]

  @@map("eventos")
}

model Confirmacion {
  id             String   @id @default(uuid()) @db.Uuid
  eventoId       String   @map("evento_id") @db.Uuid
  evento         Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  nombreInvitado String   @map("nombre_invitado")
  telefono       String?
  // "qr" o "efectivo". Nullable por las confirmaciones viejas de antes de
  // este campo — las nuevas siempre lo van a tener, validado en el POST.
  metodoPago     String?  @map("metodo_pago")
  ipOrigen       String?  @map("ip_origen")
  creadoEn       DateTime @default(now()) @map("creado_en")

  @@index([eventoId])
  // Mismo telefono no puede confirmar dos veces para el mismo partido.
  // Postgres no cuenta los NULL como iguales entre si, asi que esto no
  // choca con las confirmaciones viejas que tienen telefono null.
  @@unique([eventoId, telefono])
  @@map("confirmaciones")
}
